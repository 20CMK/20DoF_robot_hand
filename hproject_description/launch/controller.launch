<launch>

<rosparam file="$(find hproject_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="hproject" args="joint_pinky_lateral_R_position_controller joint_pinky_MCP_R_position_controller joint_pinky_PIP_R_position_controller joint_pinky_DIP_R_position_controller jonit_pinky_lateral_L_position_controller joint_pinky_MCP_L_position_controller joint_pinky_PIP_L_position_controller joint_pinky_DIP_L_position_controller joint_ring_lateral_R_position_controller jonit_ring_MCP_R_position_controller joint_ring_PIP_R_position_controller joint_ring_DIP_R_position_controller joint_ring_lateral_L_position_controller joint_ring_MCP_L_position_controller jonint_ring_PIP_L_position_controller joint_ring_DIP_L_position_controller joint_middle_lateral_R_position_controller joint_middle_MCP_R_position_controller joint_middle_PIP_R_position_controller joint_middle_DIP_R_position_controller joint_middle_lateral_L_position_controller joint_middle_MCP_L_position_controller joint_middle_PIP_L_position_controller joint_middle_DIP_L_position_controller joint_index_lateral_R_position_controller joint_index_MCP_R_position_controller joint_index_PIP_R_position_controller joint_index_DIP_R_position_controller joint_index_lateral_L_position_controller joint_index_MCP_L_position_controller joint_index_PIP_L_position_controller joint_index_DIP_L_position_controller joint_thumb_lateral_R_position_controller joint_thumb_MCP_R_position_controller joint_thumb_IP_R_position_controller joint_thumb_lateral_L_position_controller joint_thumb_MCP_L_position_controller joint_thumb_IP_L_position_controller joint_shoulder_R_position_controller joint_shoulder_L_position_controller joint_elbow_R_position_controller joint_elbow_L_position_controller joint_wrist_1_R_position_controller joint_wrist_1_L_position_controller joint_wrist_2_R_position_controller joint_wrist_2_L_position_controller joint_wheel_R_position_controller joint_wheel_L_position_controller joint_ball_L_position_controller joint_ball_R_position_controller joint_lidar_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/hproject/joint_states"/>
</node>

</launch>