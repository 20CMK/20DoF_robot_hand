  <parent link="base_link"/>
  <child link="arm_base_link_1"/>
</joint>

<joint name="joint1" type="continuous">
  <origin xyz="0.0 0.0 0.061" rpy="0 0 0"/>
  <parent link="arm_base_link_1"/>
  <child link="link1_1"/>
  <axis xyz="0.0 0.0 -1.0"/>
</joint>

<joint name="joint2" type="continuous">
  <origin xyz="0.071 0.0 0.09" rpy="0 0 0"/>
  <parent link="link1_1"/>
  <child link="link2_1"/>
  <axis xyz="-1.0 -0.0 -0.0"/>
</joint>

<joint name="joint4" type="continuous">
  <origin xyz="-0.07 0.0 0.056" rpy="0 0 0"/>
  <parent link="link3_1"/>
  <child link="link4_1"/>
  <axis xyz="0.0 -0.0 -1.0"/>
</joint>

<joint name="joint5" type="continuous">
  <origin xyz="0.0535 0.0 0.204" rpy="0 0 0"/>
  <parent link="link4_1"/>
  <child link="link5_1"/>
  <axis xyz="-1.0 0.0 -0.0"/>
</joint>

<joint name="joint6" type="continuous">
  <origin xyz="0.075 0.0 0.0535" rpy="0 0 0"/>
  <parent link="link5_1"/>
  <child link="link6_1"/>
  <axis xyz="0.0 0.0 -1.0"/>
</joint>


<link name="camera_link"/>
<joint name="realsense_to_urdf_camera_link" type="fixed">
  <parent link="camera_1"/> 
  <child link="camera_link"/> 
  <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>


<link name="camera_gyro_frame"/>
<joint name="9250_to_urdf_imu_link" type="fixed">
  <parent link="camera_link"/>
  <child link="camera_gyro_frame"/> 
  <origin xyz="0 0 -0.571" rpy="0 0 0"/>
</joint>

<link name="camera_imu_optical_frame"/>
<joint name="aaaaaa" type="fixed">
  <parent link="camera_gyro_frame"/>
  <child link="camera_imu_optical_frame"/> 
  <origin xyz="0 0 -0.0" rpy="0 0 0"/>
</joint>




<link name="laser"/>
<joint name="laser_to_urdf_lidar_link" type="fixed">
  <parent link="lidar_1"/>
  <child link="laser"/>
  <origin xyz="0 0 0.0" rpy="0 0 0"/>
</joint>


<link name="base_footprint"/>
<joint name="baselink_to_basefoorprint" type="fixed">
  <parent link="base_footprint"/>
  <child link="base_link"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <!-- <origin xyz="-0.04 0 0" rpy="0 0 0"/> -->
</joint>

</robot>
