<launch>
  <!-- Static Map -->
  <!-- <node name="map_server" pkg="map_server" type="map_server"
        args="$(find manipulator_mobile_navigation)/maps/map.yaml" /> -->

  <!-- Localization -->
  <!-- <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <param name="odom_frame_id" value="odom"/>
    <param name="base_frame_id" value="base_link"/>
    <param name="global_frame_id" value="map"/>
    <param name="use_map_topic" value="true"/>
    <remap from="scan" to="/scan"/>
  </node> -->

  <!-- Navigation -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam file="$(find mk_mobile_description)/config/costmap_common_params.yaml" command="load"/>
    <rosparam file="$(find mk_mobile_description)/config/global_costmap_params.yaml" command="load"/>
    <rosparam file="$(find mk_mobile_description)/config/local_costmap_params.yaml" command="load"/>
    <rosparam file="$(find mk_mobile_description)/config/base_local_planner_params.yaml" command="load"/>
    <remap from="scan" to="/scan"/> 
  </node>

</launch>
